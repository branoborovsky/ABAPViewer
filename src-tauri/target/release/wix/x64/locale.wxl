<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch ABAP Offline Viewer</String><String Id="DowngradeErrorMessage">A newer version of ABAP Offline Viewer is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the ABAP Offline Viewer executable to the PATH system environment variable. This allows the ABAP Offline Viewer executable to be called from any location.</String><String Id="InstallAppFeature">Installs ABAP Offline Viewer.</String></WixLocalization>